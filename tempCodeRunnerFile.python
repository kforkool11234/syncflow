def count_insertion_sort_passes(arr):
    """
    Counts how many passes in an Insertion Sort
    would involve one or more shifts.
    
    This function does NOT sort the list; it only counts.
    It operates on a copy to avoid changing the original list.
    """
    # Work on a copy to avoid modifying the original list
    l = list(arr) 
    passes_with_shifts = 0
    
    for i in range(1, len(l)):
        key = l[i]
        j = i - 1
        
        # We only need to know if the loop runs at all
        shift_happened_this_pass = False
        
        # We look for the position, but don't need to
        # do the full shift, just check if one *would* happen.
        # The first check (l[j] > key) is enough.
        if j >= 0 and l[j] > key:
            shift_happened_this_pass = True
        
        # In a real sort, a loop would continue here.
        # For counting, we just need to know if that
        # first shift (the start of the loop) was needed.
        while j >= 0 and l[j] > key:
            # We must update the list "in-place" for the
            # simulation to be correct for the next pass.
            l[j + 1] = l[j]
            j -= 1
        l[j + 1] = key # Place the key to complete the step
            
        if shift_happened_this_pass:
            passes_with_shifts += 1
            
    return passes_with_shifts

# --- Example Usage ---
my_list = [1, 4, 0, 3]
pass_count = count_insertion_sort_passes(my_list)
print(f"List: {my_list}")
print(f"Pass count: {pass_count}")

my_list_worst = [5, 4, 3, 2, 1]
pass_count = count_insertion_sort_passes(my_list_worst)
print(f"List: {my_list_worst}")
print(f"Pass count: {pass_count}")

my_list_best = [1, 2, 3, 4, 5]
pass_count = count_insertion_sort_passes(my_list_best)
print(f"List: {my_list_best}")
print(f"Pass count: {pass_count}")